{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextXode",
  "version": "1.0.0",
  "identifier": "com.contextxode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "contextxode",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://media.ethicalads.io; img-src 'self' https://media.ethicalads.io; style-src 'self' 'unsafe-inline'; connect-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    }
  }
}
